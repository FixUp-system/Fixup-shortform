# OpenAI — 대화 수집용 (gpt-4o)
OPENAI_API_KEY=sk-...

# fal.ai — 영상 생성 (https://fal.ai/dashboard/keys)
FAL_KEY=...

# 이미지 생성 모델 (단계별 워크플로우용). 비우면 fal-ai/nano-banana.
# 후보: fal-ai/nano-banana-2 (한 세대 위, 장당 $0.08 — 컷당 한 장이라 값은 같다)
# 비교: node scripts/measure/compare-image-models.mjs <projectId>
FAL_IMAGE_ENDPOINT=fal-ai/nano-banana

# 클립 모델. 눈금·오디오 설정은 lib/clip-limits.js 의 프로필이 따라온다.
#   fal-ai/kling-video/v3/standard/image-to-video  → 3~15 임의 초, ＄0.084/s(오디오 끔)
FAL_I2V_ENDPOINT=fal-ai/ltx-2.3/image-to-video/fast

# 저장 계층 (Supabase). 둘 다 없으면 서버가 뜨면서 죽는다 — 조용히 인메모리로 떨어지지 않는다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 인증 (Supabase Auth). anon 키는 Project Settings → API → anon public 에서 복사한다.
# 서버(middleware·콜백)는 SUPABASE_ANON_KEY 를, 브라우저(로그인 화면)는 NEXT_PUBLIC_ 접두어
# 붙은 두 값을 읽는다 — 셋 다 넣어야 한다. anon 키는 공개값이라 NEXT_PUBLIC_ 이 붙어도 안전하다.
# ★ SUPABASE_SERVICE_ROLE_KEY 에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다 — 붙는 순간 모든
# 방문자가 RLS 를 우회하는 열쇠를 갖는다.
SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 예산 안전핀 — 축이 둘이다(사용자 축은 크레딧 잔액이 대신하므로 env 가 없다).
# 옛 `SHOTFORM_BUDGET_USER_USD` 는 죽은 env 다 — 남아 있어도 아무도 안 읽는다.
SHOTFORM_BUDGET_TOTAL_USD=25
SHOTFORM_BUDGET_PROJECT_USD=5

# 크레딧 — 편수 ↔ USD 환산 기준가. 잔액은 저장하지 않고 충전 합계 − 쓴 합계로 낸다.
# 모델·길이가 바뀌면 이 값도 바꾼다(30초 한 편 실측 $2.59). 비우면 2.59.
# ⚠️ 기본값 $2.59 는 실측 원가와 **같아서 여유가 0 이다** — 운영에서는 조금 위로 잡아라
#    (예: 3.2). 잔액에서는 게이트 밖인 OpenAI 비용까지 깎이고 단가표에도 오차가 있어,
#    딱 한 편치만 충전한 사용자가 관통 마지막 컷 직전에 막힐 수 있다.
SHOTFORM_PER_VIDEO_USD=2.59

# 테스트 전용. 프로덕션에서는 절대 세우지 않는다.
# SHOTFORM_STORE=memory
