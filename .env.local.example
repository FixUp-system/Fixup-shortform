# OpenAI — 대화 수집용 (gpt-4o)
OPENAI_API_KEY=sk-...

# fal.ai — 영상 생성 (https://fal.ai/dashboard/keys)
FAL_KEY=...

# 사용할 비디오 모델 엔드포인트 (fal 모델 id). 교체 가능.
# 예: fal-ai/kling-video/v3/standard/text-to-video ($0.126/초, 오디오 포함)
FAL_VIDEO_ENDPOINT=fal-ai/kling-video/v3/standard/text-to-video

# 이미지 생성 모델 (단계별 워크플로우용)
FAL_IMAGE_ENDPOINT=fal-ai/nano-banana
