# ★ LLM 공급자가 둘이다 — 하나만 넣으면 절반이 죽는다.
# 대본·컷분할·화면설계·캐스팅·브리핑·대화 (lib/llm.js · app/api/chat) — Claude Opus 5
CLAUDE_API_KEY=sk-ant-...
# 이미지 검수·사진 설명만 (lib/vlm.js). 아직 gpt-4o vision 이다
OPENAI_API_KEY=sk-...

# fal.ai — 영상 생성 (https://fal.ai/dashboard/keys)
FAL_KEY=...

# 이미지 생성 모델 (단계별 워크플로우용). 비우면 코드 기본값(openai/gpt-image-2)으로 돈다.
# ★ 이 값은 lib/imagegen.js 의 activeImageEndpoint() 기본값과 **같아야 한다** — 갈리면
#   예시를 복사한 환경이 조용히 옛 모델로 돌아간다(FAL_I2V_ENDPOINT 가 실제로 그랬다).
#   tests/gpt-image-2.test.js 가 이 줄을 코드 기본값과 대조한다.
# ⚠️ 값이 5배 뛴다: nano-banana-2 1K 장당 $0.08 → GPT Image 2 quality=high 장당 $0.401.
#    컷마다 한 장이라 9컷이면 $0.72 → $3.61 이다(정가 lib/pricing.js 는 아직 이걸 모른다).
# 후보: fal-ai/nano-banana-2 (해상도가 값을 정한다, 1K $0.08 · 2K $0.12)
# 비교: node scripts/measure/compare-image-models.mjs <projectId>
FAL_IMAGE_ENDPOINT=openai/gpt-image-2

# 저장 계층 (Supabase). 둘 다 없으면 서버가 뜨면서 죽는다 — 조용히 인메모리로 떨어지지 않는다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 인증 (Supabase Auth). anon 키는 Project Settings → API → anon public 에서 복사한다.
# 서버(middleware·콜백)는 SUPABASE_ANON_KEY 를, 브라우저(로그인 화면)는 NEXT_PUBLIC_ 접두어
# 붙은 두 값을 읽는다 — 셋 다 넣어야 한다. anon 키는 공개값이라 NEXT_PUBLIC_ 이 붙어도 안전하다.
# ★ SUPABASE_SERVICE_ROLE_KEY 에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다 — 붙는 순간 모든
# 방문자가 RLS 를 우회하는 열쇠를 갖는다.
SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 예산 안전핀(USD) — 축이 하나다. 사용자 축은 크레딧 잔액이, 체험 축은 lib/pricing.js 의
# FREE_TRIAL_USD 가 맡으므로 둘 다 env 가 없다. 없으면 코드 기본값(전역 300)으로 돈다.
# 전역은 우리 지갑의 마지막 방어선이다 — 버그로 폭주할 때 여기서 멎는다.
# 옛 `SHOTFORM_BUDGET_USER_USD` · `SHOTFORM_BUDGET_PROJECT_USD` 는 죽은 env 다
# (프로젝트 축은 2026-08-12 에 걷어냈다 — 요금 상한처럼 굴어 정상 사용을 막았다).
SHOTFORM_BUDGET_TOTAL_USD=300

# 크레딧에는 env 가 없다 — 가격은 `lib/pricing.js` 하나가 정한다.
# 길이별 정가(15/30/45/60초 = 25/50/75/100 크레딧)·재생성 단가(이미지 2·클립 8·목소리 1)·
# 컷당 1회 무료 재생성·기본 충전량(500)이 전부 거기 있다. 값을 바꾸려면 그 파일을 고친다.
# 옛 `SHOTFORM_PER_VIDEO_USD` 는 죽은 env 다 — 편수 표기가 폐지되면서 아무도 안 읽는다.

# 측정 스크립트(scripts/measure/*.mjs)가 누구로 도는가 — 크레딧을 가진 실제 사용자 uuid.
#
# 비우면 "admin" 으로 돈다. `"admin"` 은 **충전이 불가능한 영구 체험자**다:
# `credit_grants.user_id` 가 `uuid references auth.users(id)` 라 그 문자열은 애초에
# 못 들어간다. 그래서 `assertBudget` 의 체험 한도(누적 원가 $0.5, `FREE_TRIAL_USD`)에
# 걸리고, 원장의 `actor="admin"` 누적 합계가 이미 넘었으면 **첫 유료 호출부터 죽는다**
# (BudgetExceeded, scope="trial"). 체험 판정은 "앞으로 얼마"가 아니라 **누적 총합**이다.
#
# 코드에 `"admin"` 예외를 파지 않는다 — 그러면 그 이름 하나로 한도가 통째로 열린다.
# 여기에 uuid 를 넣어 **크레딧을 가진 사람으로** 돌린다(잔액이 있으면 그물을 지나간다).
# 가짜 모드(SHOTFORM_FAKE=all)로 도는 측정은 애초에 이 게이트를 안 거친다.
#
# ⚠️ 측정 스크립트는 `.env.local` 을 스스로 읽지 않는다(FAL_KEY 와 같다) — 여기 적어 두고
# 돌릴 때 환경변수로 넣는다: `SHOTFORM_MEASURE_USER=<uuid> node scripts/measure/...`
# SHOTFORM_MEASURE_USER=00000000-0000-0000-0000-000000000000

# 테스트 전용. 프로덕션에서는 절대 세우지 않는다.
# SHOTFORM_STORE=memory
